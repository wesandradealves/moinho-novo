WORDPRESS_PORT=8080

WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress
MARIADB_ROOT_PASSWORD=root
WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_DEBUG=0

# Redis (object cache)
WORDPRESS_REDIS_HOST=redis
WORDPRESS_REDIS_PORT=6379
WORDPRESS_REDIS_DATABASE=0
WORDPRESS_REDIS_PREFIX=moinho_novo

# Redis Cache plugin (auto download by default)
# REDIS_CACHE_AUTO_DOWNLOAD=1
# REDIS_CACHE_DOWNLOAD_URL=https://downloads.wordpress.org/plugin/redis-cache.latest-stable.zip
# REDIS_CACHE_ZIP_URL=
# REDIS_CACHE_ZIP_PATH=
# REDIS_CACHE_ZIP_SHA256=

# Oxygen license key (store carefully if you plan to version this file)
# OXYGEN_LICENSE_KEY=

# Optional path inside container for DB dump (default mounted in docker-compose.yml)
# WORDPRESS_DB_DUMP=/opt/seed/db.sql

# Use the default "latest" tarball, or pin to a specific version URL if needed.
WORDPRESS_DOWNLOAD_URL=https://wordpress.org/latest.tar.gz

# Oxygen Builder (commercial). Provide a direct download URL from your account.
# OXYGEN_ZIP_URL=
# Local Oxygen zip path inside the container (default set in docker-compose.yml).
# OXYGEN_ZIP_PATH=/opt/oxygen/oxygen.zip
# Optional integrity check for the zip.
# OXYGEN_ZIP_SHA256=

# Contact Form 7 (free). Use local zip (mounted) or a direct URL if desired.
# CONTACT_FORM_7_ZIP_URL=
# CONTACT_FORM_7_ZIP_PATH=/opt/plugins/contact-form-7.zip
# CONTACT_FORM_7_ZIP_SHA256=
