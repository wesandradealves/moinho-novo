# Defina apenas o que quiser sobrescrever dos defaults do docker-compose.yml.

# WORDPRESS_PORT=
# WORDPRESS_DB_NAME=
# WORDPRESS_DB_USER=
# WORDPRESS_DB_PASSWORD=
# MARIADB_ROOT_PASSWORD=
# WORDPRESS_TABLE_PREFIX=
# WORDPRESS_DEBUG=

# Redis (object cache)
# WORDPRESS_REDIS_HOST=
# WORDPRESS_REDIS_PORT=
# WORDPRESS_REDIS_DATABASE=
# WORDPRESS_REDIS_PREFIX=

# Redis Cache plugin (auto download by default)
# REDIS_CACHE_AUTO_DOWNLOAD=
# REDIS_CACHE_DOWNLOAD_URL=
# REDIS_CACHE_ZIP_URL=
# REDIS_CACHE_ZIP_PATH=
# REDIS_CACHE_ZIP_SHA256=

# All-in-One WP Migration Unlimited (local zip ou URL)
# AIOWPM_ZIP_URL=
# AIOWPM_ZIP_PATH=
# AIOWPM_ZIP_SHA256=
# AIOWPM_PLUGIN_FILE=

# WP-Optimize (local zip ou URL)
# WP_OPTIMIZE_ZIP_URL=
# WP_OPTIMIZE_ZIP_PATH=
# WP_OPTIMIZE_ZIP_SHA256=
# WP_OPTIMIZE_PLUGIN_FILE=

# Defender Security (local zip ou URL)
# DEFENDER_ZIP_URL=
# DEFENDER_ZIP_PATH=
# DEFENDER_ZIP_SHA256=
# DEFENDER_PLUGIN_FILE=

# Oxygen license key (cuidado ao versionar)
# OXYGEN_LICENSE_KEY=

# Optional path inside container for DB dump (default mounted in docker-compose.yml)
# WORDPRESS_DB_DUMP=

# Use the default "latest" tarball, or pin to a specific version URL if needed.
# WORDPRESS_DOWNLOAD_URL=

# Oxygen Builder (commercial). Provide a direct download URL from your account.
# OXYGEN_ZIP_URL=
# Local Oxygen zip path inside the container (default set in docker-compose.yml).
# OXYGEN_ZIP_PATH=
# Optional integrity check for the zip.
# OXYGEN_ZIP_SHA256=

# Contact Form 7 (free). Use local zip (mounted) or a direct URL if desired.
# CONTACT_FORM_7_ZIP_URL=
# CONTACT_FORM_7_ZIP_PATH=
# CONTACT_FORM_7_ZIP_SHA256=
